# Used by mcp_server.py (the Streamlit app instead reads .streamlit/secrets.toml,
# falling back to these same env vars).

# Required for get_macro_briefing — get a free key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_ai_studio_key_here

# Optional — improves credit-spread / yield-curve accuracy (falls back to a
# deterministic proxy otherwise). Get a free key at https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=your_fred_api_key_here

# Optional — port for the MCP server's Streamable HTTP endpoint (default 8000)
PORT=8000
